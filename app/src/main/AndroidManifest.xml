<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required for dropping the notification over the screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- THE MAGIC KEY: Required for Display Over Other Apps! -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Mindbreak"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mindbreak">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Mindbreak"
            android:theme="@style/Theme.Mindbreak">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registering the transparent overlay activity -->
        <activity
            android:name=".PuzzleOverlayActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTask" />

    </application>


</manifest>